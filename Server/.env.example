NODE_ENV=development
PORT=5000
MONGOURL=mongodb://127.0.0.1:27017/squadscript
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
# Optional comma-separated override, for example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=
SESSION_COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=1mb
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
OTP_RATE_LIMIT_MAX=5
COMPILER_RATE_LIMIT_MAX=20
DB_CONNECT_TIMEOUT_MS=10000
DB_MAX_POOL_SIZE=10
CRON_TIMEZONE=UTC
EMAIL=
PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
DEV1=
DEV2=
VIDEO_SDK_TOKEN=
RAPID_API_KEY=
X_RAPID_HOST=
